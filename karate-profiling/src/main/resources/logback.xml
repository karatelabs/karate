<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pinned to WARN on purpose. A profiling run that spends its time formatting log
  lines is measuring the logger, not Karate — and every line allocates, which lands
  in the same allocation panel we are trying to read.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <immediateFlush>false</immediateFlush>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.karatelabs" level="WARN"/>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
